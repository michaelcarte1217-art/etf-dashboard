{
  "name": "etf-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ETF 数据看板：实时行情、持仓盈亏、MACD / 布林带指标可视化（Vue 3 + ECharts）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "postbuild": "node scripts/postbuild.mjs",
    "data": "python scripts/fetch_klines.py"
  },
  "dependencies": {
    "echarts": "^5.5.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
